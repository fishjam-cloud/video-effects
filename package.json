{
  "name": "@fishjam-cloud/video-effects",
  "version": "0.1.1",
  "description": "WebGPU video effects and person-segmentation providers for Fishjam video sources",
  "license": "Apache-2.0",
  "author": "Fishjam Team",
  "main": "./dist/module/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "react-native": "./dist/module/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "react-native": "./dist/module/index.js",
      "import": "./dist/module/index.js",
      "default": "./dist/module/index.js"
    },
    "./background-blur": {
      "types": "./dist/typescript/background-blur.d.ts",
      "react-native": "./dist/module/background-blur.js",
      "import": "./dist/module/background-blur.js",
      "default": "./dist/module/background-blur.js"
    },
    "./background-image": {
      "types": "./dist/typescript/background-image.d.ts",
      "react-native": "./dist/module/background-image.js",
      "import": "./dist/module/background-image.js",
      "default": "./dist/module/background-image.js"
    },
    "./segmentation/typegpu": {
      "types": "./dist/typescript/segmentation/typegpu/index.d.ts",
      "react-native": "./dist/module/segmentation/typegpu/index.js",
      "import": "./dist/module/segmentation/typegpu/index.js",
      "default": "./dist/module/segmentation/typegpu/index.js"
    },
    "./web": {
      "types": "./dist/typescript/web.d.ts",
      "import": "./dist/module/web.js",
      "default": "./dist/module/web.js"
    },
    "./fishjam-react": {
      "types": "./dist/typescript/fishjam-react.d.ts",
      "import": "./dist/module/fishjam-react.js",
      "default": "./dist/module/fishjam-react.js"
    },
    "./fishjam-react-native": {
      "types": "./dist/typescript/fishjam-react-native.d.ts",
      "react-native": "./dist/module/fishjam-react-native.js",
      "import": "./dist/module/fishjam-react-native.js",
      "default": "./dist/module/fishjam-react-native.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/**",
    "dist/**",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishjam-cloud/video-effects.git"
  },
  "scripts": {
    "build": "bob build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts --fix",
    "lint:check": "eslint src --ext .ts",
    "prepack": "yarn build",
    "test": "yarn tsc && yarn lint:check && yarn format:check",
    "tsc": "tsc --noEmit"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "configFile": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@webgpu/types": "0.1.65",
    "typed-binary": "^4.3.3",
    "typegpu": "^0.12.0"
  },
  "peerDependencies": {
    "@fishjam-cloud/react-client": "*",
    "@fishjam-cloud/react-native-client": "*",
    "@fishjam-cloud/react-native-webrtc": ">=0.30.2",
    "react": ">=18",
    "react-native": "*",
    "react-native-webgpu": ">=0.5.15",
    "react-native-worklets": ">=0.12.1"
  },
  "peerDependenciesMeta": {
    "@fishjam-cloud/react-client": {
      "optional": true
    },
    "@fishjam-cloud/react-native-client": {
      "optional": true
    },
    "@fishjam-cloud/react-native-webrtc": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-webgpu": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.27.0",
    "@fishjam-cloud/react-client": "^0.29.0",
    "@fishjam-cloud/react-native-client": "^0.30.0",
    "@fishjam-cloud/react-native-webrtc": "0.30.2",
    "@types/react": "19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.5.3",
    "react": "19.1.0",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.18.2",
    "react-native-webgpu": "0.5.15",
    "typescript": "^5.8.3",
    "unplugin-typegpu": "^0.12.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.16.0",
  "homepage": "https://github.com/fishjam-cloud/video-effects#readme",
  "bugs": "https://github.com/fishjam-cloud/video-effects/issues"
}
